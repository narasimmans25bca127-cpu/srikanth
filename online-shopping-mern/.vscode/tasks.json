{
  "version": "2.0.0",
  "tasks": [
    { "label": "Backend: install", "type": "shell", "command": "npm install", "options": { "cwd": "${workspaceFolder}/backend" }, "problemMatcher": [] },
    { "label": "Frontend: install", "type": "shell", "command": "npm install", "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": [] },
    { "label": "Backend: start", "type": "shell", "command": "npm run dev", "options": { "cwd": "${workspaceFolder}/backend" }, "isBackground": true, "problemMatcher": [] },
    { "label": "Frontend: start", "type": "shell", "command": "npm run dev", "options": { "cwd": "${workspaceFolder}/frontend" }, "isBackground": true, "problemMatcher": [] },
    { "label": "Install all", "dependsOn": ["Backend: install", "Frontend: install"], "dependsOrder": "parallel", "problemMatcher": [] },
    { "label": "Start all (backend + frontend)", "dependsOn": ["Backend: start", "Frontend: start"], "dependsOrder": "parallel", "problemMatcher": [] }
  ]
}
