# Copy this file to ".env" and fill in the values
PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/shopease
# MongoDB Atlas (replace user, password and cluster):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopease?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Set locally before running `npm run provision-admin`; never commit the value.
ADMIN_INITIAL_PASSWORD=

# URL of the React app (used for CORS)
CLIENT_URL=http://localhost:5173
NODE_ENV=development
